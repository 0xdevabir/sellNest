{
  "name": "sellnest",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "build:shared": "pnpm --filter @sellnest/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @sellnest/api --filter @sellnest/web dev",
    "build": "pnpm build:shared && pnpm --filter @sellnest/api build && pnpm --filter @sellnest/web build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm build:shared && pnpm -r test",
    "test:e2e": "pnpm --filter @sellnest/e2e test",
    "db:migrate": "pnpm --filter @sellnest/api db:migrate",
    "db:seed": "pnpm --filter @sellnest/api db:seed",
    "db:demo:remove": "pnpm --filter @sellnest/api db:demo:remove",
    "admin:bootstrap": "pnpm --filter @sellnest/api admin:bootstrap",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
