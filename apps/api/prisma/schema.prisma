// SellNest data model. Business rules worth knowing are explained in docs/ARCHITECTURE.md.
// geography and tsvector columns are generated by PostgreSQL (see migration 0002) and are
// never written by application code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum LocationType {
  COUNTRY
  DIVISION
  DISTRICT
  CITY
  AREA
  CAMPUS
  COMMUNITY
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  SOLD
  ARCHIVED
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  FOR_PARTS
  REFURBISHED
}

enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum MessageType {
  TEXT
  SYSTEM
}

enum NotificationType {
  NEW_MESSAGE
  NEW_OFFER
  OFFER_ACCEPTED
  OFFER_REJECTED
  OFFER_COUNTERED
  OFFER_CANCELLED
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_SOLD
  ACCOUNT_SECURITY
  REVIEW_RECEIVED
}

enum ReportTarget {
  LISTING
  USER
  MESSAGE
  CONVERSATION
}

enum ReportReason {
  COUNTERFEIT
  STOLEN
  FRAUD
  PROHIBITED
  SPAM
  MISLEADING
  HARASSMENT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique
  passwordHash     String
  username         String     @unique
  displayName      String
  bio              String?
  avatarKey        String?
  role             UserRole   @default(USER)
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?
  profileCompleted Boolean    @default(false)
  showSoldListings Boolean    @default(true)
  defaultRadiusKm  Int        @default(5)
  locationId       String?    @db.Uuid
  isDemo           Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  location        Location?                 @relation(fields: [locationId], references: [id], onDelete: SetNull)
  sessions        Session[]
  authTokens      AuthToken[]
  listings        Listing[]                 @relation("seller")
  purchases       Listing[]                 @relation("buyer")
  images          ListingImage[]
  favorites       Favorite[]
  participations  ConversationParticipant[]
  buyerChats      Conversation[]            @relation("chatBuyer")
  sellerChats     Conversation[]            @relation("chatSeller")
  messages        Message[]
  buyerOffers     Offer[]                   @relation("offerBuyer")
  sellerOffers    Offer[]                   @relation("offerSeller")
  offerEvents     OfferEvent[]
  notifications   Notification[]
  reportsFiled    Report[]                  @relation("reporter")
  reportsResolved Report[]                  @relation("resolver")
  reportsAgainst  Report[]                  @relation("reportedUser")
  reviewsWritten  Review[]                  @relation("reviewer")
  reviewsReceived Review[]                  @relation("reviewee")
  blocking        Block[]                   @relation("blocker")
  blockedBy       Block[]                   @relation("blocked")
  auditLogs       AuditLog[]

  @@index([createdAt])
  @@index([status])
}

/// Opaque browser session. Only the SHA-256 of the cookie value is stored.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  userAgent  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  userId    String        @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

/// One table for geography and communities. parentId is optional so a campus or community
/// can sit outside the Country > Division > District > City > Area hierarchy.
model Location {
  id         String       @id @default(uuid()) @db.Uuid
  slug       String       @unique
  name       String
  type       LocationType
  parentId   String?      @db.Uuid
  latitude   Float
  longitude  Float
  geo        Unsupported("geography(Point,4326)")?
  isFeatured Boolean      @default(false)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  parent   Location?  @relation("hierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Location[] @relation("hierarchy")
  listings Listing[]
  users    User[]

  @@index([parentId])
  @@index([type, isActive])
  @@index([geo], type: Gist)
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  icon      String?
  parentId  String?  @db.Uuid
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("tree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("tree")
  listings Listing[]

  @@index([parentId, sortOrder])
}

model Listing {
  id               String            @id @default(uuid()) @db.Uuid
  sellerId         String            @db.Uuid
  status           ListingStatus     @default(DRAFT)
  title            String?
  description      String?
  categoryId       String?           @db.Uuid
  condition        ListingCondition?
  brand            String?
  model            String?
  priceBdt         Int?
  originalPriceBdt Int?
  negotiable       Boolean           @default(false)
  locationId       String?           @db.Uuid
  /// Copied from the Location centre on save, so a listing's position is always an area and
  /// never a home. Precise user coordinates are not stored anywhere.
  latitude         Float?
  longitude        Float?
  geo              Unsupported("geography(Point,4326)")?
  searchVector     Unsupported("tsvector")?
  meetupAvailable  Boolean           @default(true)
  deliveryAvailable Boolean          @default(false)
  rejectionReason  String?
  flagReason       String?
  viewCount        Int               @default(0)
  publishedAt      DateTime?
  soldAt           DateTime?
  soldPriceBdt     Int?
  soldToUserId     String?           @db.Uuid
  isDemo           Boolean           @default(false)
  /// Soft delete: conversations, offers and reports must still resolve after removal.
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  seller        User           @relation("seller", fields: [sellerId], references: [id], onDelete: Restrict)
  soldTo        User?          @relation("buyer", fields: [soldToUserId], references: [id], onDelete: SetNull)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location      Location?      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]
  offers        Offer[]
  reviews       Review[]
  reports       Report[]

  @@index([sellerId, status])
  @@index([status, publishedAt(sort: Desc)])
  @@index([status, priceBdt])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([locationId, status, publishedAt(sort: Desc)])
  @@index([geo], type: Gist)
  @@index([searchVector], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Listing_title_trgm_idx")
}

/// Variants live at {keyBase}/{width}.webp in object storage. listingId is null until the
/// image is attached; unattached uploads are removed by the cleanup job.
model ListingImage {
  id         String   @id @default(uuid()) @db.Uuid
  listingId  String?  @db.Uuid
  uploaderId String   @db.Uuid
  keyBase    String   @unique
  width      Int
  height     Int
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  listing  Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
  @@index([listingId, createdAt])
}

model Favorite {
  userId    String   @db.Uuid
  listingId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
  @@index([userId, createdAt(sort: Desc)])
}

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  listingId     String    @db.Uuid
  buyerId       String    @db.Uuid
  sellerId      String    @db.Uuid
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  listing      Listing                   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer        User                      @relation("chatBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller       User                      @relation("chatSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  participants ConversationParticipant[]
  messages     Message[]
  reports      Report[]

  @@unique([listingId, buyerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
}

model ConversationParticipant {
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  lastReadAt     DateTime @default(now())
  unreadCount    Int      @default(0)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  senderId       String?     @db.Uuid
  type           MessageType @default(TEXT)
  body           String
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  reports      Report[]

  @@index([conversationId, createdAt(sort: Desc)])
}

/// Migration 0002 adds partial unique indexes: one open offer per buyer per listing, and one
/// accepted offer per listing. They hold even if two requests race past application checks.
model Offer {
  id        String      @id @default(uuid()) @db.Uuid
  listingId String      @db.Uuid
  buyerId   String      @db.Uuid
  sellerId  String      @db.Uuid
  amountBdt Int
  note      String?
  status    OfferStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  listing Listing      @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer   User         @relation("offerBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller  User         @relation("offerSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  events  OfferEvent[]

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([listingId, status])
}

model OfferEvent {
  id        String   @id @default(uuid()) @db.Uuid
  offerId   String   @db.Uuid
  actorId   String   @db.Uuid
  type      String
  amountBdt Int?
  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([offerId, createdAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @db.Uuid
  targetType     ReportTarget
  listingId      String?      @db.Uuid
  reportedUserId String?      @db.Uuid
  messageId      String?      @db.Uuid
  conversationId String?      @db.Uuid
  reason         ReportReason
  details        String?
  status         ReportStatus @default(OPEN)
  note           String?
  resolvedById   String?      @db.Uuid
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  reporter     User          @relation("reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolvedBy   User?         @relation("resolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  reportedUser User?         @relation("reportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  listing      Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([reporterId])
}

/// Eligibility: only the buyer the seller named when marking the listing sold can review.
/// This is seller-confirmed, not a verified payment, and the UI must not claim otherwise.
model Review {
  id         String   @id @default(uuid()) @db.Uuid
  listingId  String   @db.Uuid
  reviewerId String   @db.Uuid
  revieweeId String   @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  reviewer User    @relation("reviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewee User    @relation("reviewee", fields: [revieweeId], references: [id], onDelete: Restrict)

  @@unique([listingId, reviewerId])
  @@index([revieweeId, createdAt(sort: Desc)])
}

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
