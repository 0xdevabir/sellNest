# Local development defaults. Copy to .env. These values only work with docker-compose.yml.
NODE_ENV=development
TZ=Asia/Dhaka

# Public URL of the web app. Also the only allowed browser origin unless CORS_ORIGINS adds more.
WEB_URL=http://localhost:3100
CORS_ORIGINS=
API_PORT=4100
# Where the Next.js server reaches the API (server-side rendering and /api rewrites).
API_INTERNAL_URL=http://127.0.0.1:4100

DATABASE_URL=postgresql://sellnest:sellnest_dev_only@127.0.0.1:55532/sellnest?schema=public&connection_limit=10
REDIS_URL=redis://127.0.0.1:56479

# Object storage: any S3-compatible provider (MinIO locally, Cloudflare R2 or S3 in production).
# Leave S3_BUCKET empty to run without uploads: the sell flow then shows a setup-required notice.
S3_ENDPOINT=http://127.0.0.1:59100
S3_REGION=auto
S3_BUCKET=sellnest-images
S3_ACCESS_KEY_ID=sellnest
S3_SECRET_ACCESS_KEY=sellnest_dev_only
S3_FORCE_PATH_STYLE=true
# Public base URL that serves the bucket's objects.
S3_PUBLIC_URL=http://127.0.0.1:59100/sellnest-images

# Email. Mailpit captures everything locally: http://127.0.0.1:58025
SMTP_HOST=127.0.0.1
SMTP_PORT=51125
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=SellNest <no-reply@sellnest.local>

# Set to true only on the process that should run background jobs. Compose runs a dedicated worker.
RUN_WORKER_IN_API=true

# One-time admin bootstrap: pnpm admin:bootstrap. Remove after use.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
