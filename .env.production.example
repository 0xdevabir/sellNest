# Copy to .env.production (or .env.staging) on the server. Never commit the copy.
# Every REPLACE_ value must be yours. Generate secrets with: openssl rand -hex 32

# Public https address of this environment.
WEB_URL=https://REPLACE_WITH_YOUR_DOMAIN
CORS_ORIGINS=
CONTACT_EMAIL=REPLACE_WITH_SUPPORT_ADDRESS

# Where the nginx container listens on the server. Your TLS proxy forwards here.
# Keep it on 127.0.0.1. Give staging a different port.
HTTP_BIND=127.0.0.1:8088
IMAGE_TAG=latest

POSTGRES_USER=sellnest
POSTGRES_DB=sellnest
# Use hex: this value goes into a connection URL, where symbols would need escaping.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
DB_CONNECTION_LIMIT=10
REDIS_PASSWORD=REPLACE_WITH_GENERATED_SECRET
# Set on arm64 servers, where the official image has no build: imresamu/postgis:17-3.5
# POSTGIS_IMAGE=postgis/postgis:17-3.5

# S3-compatible storage. Leave S3_BUCKET empty and the sell flow shows a setup-required notice.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=

# Required: the API refuses to start without email, since nobody could verify an account.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=SellNest <no-reply@REPLACE_WITH_YOUR_DOMAIN>
